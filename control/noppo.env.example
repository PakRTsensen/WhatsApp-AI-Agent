# Copy this file to control/noppo.env (chmod 600) and fill in real values.
# scripts/install.sh does this automatically.

# WhatsApp numbers: digits only, comma separated for multiple owners.
BOT_OWNER_NUMBERS=628xxxxxxxxxx
BOT_NUMBER=628xxxxxxxxxx
# Optional: set for a pairing code; leave empty to pair with a QR code.
PAIRING_NUMBER=

# OpenCode engine.
NOPPO_OPENCODE_BINARY=/usr/local/bin/opencode
NOPPO_ENGINE_PROVIDER=9router
NOPPO_AGENT=noppo
NOPPO_WORKDIR=/opt/WhatsApp-AI-Agent

# OpenAI-compatible router used by /noppo vision (image analysis).
NOPPO_ROUTER_URL=http://127.0.0.1:20128/v1
NOPPO_ROUTER_API_KEY=

# Optional voice transcription overrides.
# WA_STT_PYTHON=/path/to/venv/bin/python
# WA_STT_MODEL=small
